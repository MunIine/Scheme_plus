#the mod name as displayed in-game
displayName: "Scheme+"

#the internal name of your mod
name: "scheme_plus"

#your name
author: "Munline"

#the fully qualified main class of the mod
main: "scheme_plus.SchemePlus"

#the mod description as seen in the mod dialog
description: "Scheme Plus adds a compact breakdown of every item and liquid the schematic consumes or produces per second."

#the mod version
version: "v2.0.1"

#the minimum game build required to run this mod
minGameVersion: 158

#this is a java mod
java: true

#this is a client-side only mod (overrides the schematics UI), so it must not participate in multiplayer mod checks
hidden: true
